# Copy to .env and export the variables you have. Leave the rest unset.
# With nothing set, the factory uses in-process fakes and FACTORY_AUTH_MODE=dev.

# dev | github
FACTORY_AUTH_MODE=dev
FACTORY_SESSION_SECRET=replace-me

# Postgres from deploy/compose. SQLite works for a local demo.
FACTORY_DATABASE_URL=postgresql+asyncpg://factory:factory@127.0.0.1:54329/factory
FACTORY_TEMPORAL_ADDRESS=localhost:7233
FACTORY_TEMPORAL_NAMESPACE=default
FACTORY_REPO_ROOT=.

# One GitHub App. Use its client id and secret for user login (no second OAuth app).
# Callback: http://127.0.0.1:43123/auth/github/callback
# Permissions: Metadata read, Contents write, Pull requests write, Checks read,
# Statuses read, Actions read. Nothing else. The app never merges.
# FACTORY_SECRET_KEY encrypts the user token at rest. It falls back to FACTORY_SESSION_SECRET.
FACTORY_GITHUB_APP_ID=
FACTORY_GITHUB_APP_SLUG=
FACTORY_GITHUB_APP_PRIVATE_KEY=
FACTORY_GITHUB_WEBHOOK_SECRET=
FACTORY_GITHUB_CLIENT_ID=
FACTORY_GITHUB_CLIENT_SECRET=
FACTORY_SECRET_KEY=
FACTORY_GITHUB_REDIRECT_URI=http://127.0.0.1:43123/auth/github/callback
FACTORY_CONSOLE_URL=http://127.0.0.1:43124
# Comma-separated GitHub logins. Everyone else who signs in is a requester.
FACTORY_ADMIN_USERS=
FACTORY_APPROVER_USERS=
# Cloudflare Access. Team is the name in <team>.cloudflareaccess.com. PEM is for local tests.
FACTORY_CF_ACCESS_TEAM=
FACTORY_CF_ACCESS_AUD=
FACTORY_CF_ACCESS_PEM=
# Set to 1 only if the App has Repository creation and you want New app to create repos.
FACTORY_GITHUB_ALLOW_CREATE_REPO=

# Models. LiteLLM is an OpenAI-compatible proxy. Budgets are enforced in the module.
FACTORY_LITELLM_URL=
FACTORY_LITELLM_API_KEY=
# Set to 1 to call litellm.acompletion in-process instead of the proxy.
FACTORY_LITELLM_EMBEDDED=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FACTORY_HARNESS_TIMEOUT=600
FACTORY_HARNESS_RETRIES=2

# auto uses a container when the daemon is up. host forces the workspace fallback.
FACTORY_DOCKER_SANDBOX=auto
# auto uses the sbx CLI when it is on PATH, otherwise docker.
FACTORY_SANDBOX_ENGINE=auto
FACTORY_SANDBOX_IMAGE=factory-sandbox:local

# Modal burst sandbox. Absent means the module uses a host workspace.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional example secret resolved by secrets-host.
FACTORY_EXAMPLE_SECRET=
